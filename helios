#!/usr/bin/env python
from typing import IO
import nodes
from nodes import *


class Frame:
    def __init__(self, parent=None):
        self.parent = parent
        self.vars = {}
        self._stack = []
        if parent:
            self._stack = parent._stack  # Shared stack logic

    def push(self, value):
        self._stack.append(value)

    def pop(self):
        if not self._stack:
            raise ValueError("Stack underflow")
        x = self._stack.pop()
        return x

    def top(self):
        if not self._stack:
            raise ValueError("Stack underflow")
        x = self._stack[-1]
        return x

    def set(self, name, value):
        self.vars[name] = value

    def get(self, name):
        if name in ["true", "false"]:
            return name == "true"
        if name in self.vars:
            return self.vars[name]
        if self.parent:
            return self.parent.get(name)
        raise ValueError(f"{name} is not defined")


class Vm:
    def __init__(self, filename):
        with open(filename, "r") as f:
            raw_tokens = tokenizer.tokenize(f.read(), f.name)

        # Phase 1: Parsing
        parser = Parser(raw_tokens)
        self.functions = parser.parse_program()

        # Phase 2: Runtime Setup
        self.frames = [Frame()]
        self.funcs = {}

    def run_function(self, fn_def: FunctionDef):
        # Bind Arguments
        # Note: In stack languages, args are usually popped in reverse order
        for arg_name in reversed(fn_def.args):
            val = self.frames[-1].pop()
            self.frames[-1].set(arg_name, val)

        self.execute_block(fn_def.body)

    def execute_block(self, block: Block):
        for node in block.statements:
            try:
                if not self.frames:
                    break  # handled 'done'
                before = self.frames[-1]._stack.copy()
                self.execute_node(node)
                after = self.frames[-1]._stack
                if nodes.strace:
                    print("    - " * (len(self.frames) - 1), end="", file=sys.stderr)
                    print(f"{node} :: {before} -> {after}", file=sys.stderr)
            except Return:
                break

    def execute_node(self, node: ASTNode):
        frame = self.frames[-1]

        if isinstance(node, Literal):
            frame.push(node.value)

        elif isinstance(node, Identifier):
            if node.name in self.functions:
                if len(self.frames) >= MAX_F:
                    raise ValueError("Stack overflow")

                new_frame = Frame(frame)
                self.frames.append(new_frame)
                if nodes.strace:
                    print(" " * (len(self.frames) - 1), end="", file=sys.stderr)
                    print(">>", node.name, file=sys.stderr)
                self.run_function(self.functions[node.name])
                if nodes.strace:
                    print(" " * (len(self.frames) - 1), end="", file=sys.stderr)
                    print("<<", node.name, file=sys.stderr)
                self.frames.pop()
            # Check for Variables
            else:
                val = frame.get(node.name)
                frame.push(val)

        elif isinstance(node, Intrinsic):
            if node.name == "pop":
                frame.pop()
            elif node.name == "top":
                size = len(frame._stack)
                frame.push(size)
            elif node.name == "return":
                raise Return()
            elif node.name == "break":
                raise Break()
            elif node.name == "continue":
                raise Continue()
            elif node.name == "DEBUG_ACTIVE":
                frame.push(nodes.strace)
            elif node.name == "done":
                self.frames.clear()  # Hard stop

        elif isinstance(node, If):
            cond = frame.pop()
            if cond:
                self.execute_block(node.body)
            elif node.else_block:
                self.execute_block(node.else_block)

        elif isinstance(node, Op):
            b = frame.pop()
            a = frame.pop()
            sb = {
                "+": lambda a, b: a + b,
                "-": lambda a, b: a - b,
                "/": lambda a, b: a / b,
                "*": lambda a, b: a * b,
                "==": lambda a, b: a == b,
                "!=": lambda a, b: a != b,
                ">": lambda a, b: a > b,
                "<": lambda a, b: a < b,
            }
            frame.push(sb[node.symbol](a, b))

        elif isinstance(node, Attribute):
            val = frame.pop()
            if node.name == "str":
                frame.push(str(val))
            elif node.name == "int":
                frame.push(int(val))
            elif node.name == "float":
                frame.push(float(val))
            elif node.name == "bool":
                frame.push(bool(val))
            elif node.name == "type":
                frame.push(type(val))
            else:
                frame.push(val)
                self.funcs[node.name](frame)

        elif isinstance(node, Repeat):
            count = frame.pop()
            if not isinstance(count, int):
                raise ValueError(f"Repeat count must be int, got {type(count)}")
            for _ in range(count):
                try:
                    self.execute_block(node.body)
                except Break:
                    break
                except Continue:
                    continue

        elif isinstance(node, While):
            while True:
                try:
                    self.execute_block(node.body)
                except Break:
                    break
                except Continue:
                    continue
                v = frame.pop()
                if not v:
                    break

        elif isinstance(node, MultiSet):
            # [ a, b ] pops b, then a
            # The list in AST is [a, b].
            # Stack top is 'b value', then 'a value'.

            # We need to assign right-to-left based on stack order
            for name in reversed(node.names):
                frame.set(name, frame.pop())

    def run(self):
        if "main" not in self.functions:
            raise ValueError("No main function defined")

        # Create a frame for main and run it
        self.run_function(self.functions["main"])


class API:
    _builtins = []
    _onsetup = []

    @classmethod
    def add(cls, fn):
        cls._builtins.append(fn)
        return fn

    @classmethod
    def onsetup(cls, fn):
        cls._onsetup.append(fn)
        return fn

    def __init__(self, vm):
        self.vm = vm

        vm.frames[0].set("stdin", sys.stdin)
        vm.frames[0].set("argv", sys.argv)
        vm.frames[0].set("stdout", sys.stdout)
        vm.frames[0].set("stderr", sys.stderr)

        for i in self._onsetup:
            i(self, vm)

        for i, fn in enumerate(self._builtins, start=1):
            vm.funcs[fn.__name__.lower()] = fn


@API.add
def Open(f):
    path = f.pop()
    mode = f.pop()
    f.push(open(path, mode))


@API.add
def write(f):
    where: IO = f.pop()
    text = f.pop()
    where.write(text)


@API.add
def read(f):
    where: IO = f.pop()
    bcount = f.pop()
    f.push(where.read(bcount))


@API.add
def flush(f):
    f.pop().flush()


@API.add
def head(f):
    v = f.pop()[0]
    # print(v)
    f.push(v)


@API.add
def reverse(f):
    f.top().reverse()


@API.add
def length(f: Frame):
    v = f.pop()
    # print(v)
    f.push(len(v))


@API.add
def tail(f):
    f.push(f.pop()[-1])


def buildBuiltins(interp: Vm):
    API(interp)


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: ./helios.py <file>")
        sys.exit(1)
    vm = Vm(sys.argv[1])
    sys.argv.reverse()
    sys.argv.pop()
    buildBuiltins(vm)
    vm.run()
